[configuration]
entry_symbol = "microtex_library_init"
compatibility_minimum = "4.1"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://addons/microtex/bin/libmicrotex.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/microtex/bin/libmicrotex.linux.template_release.x86_64.so"
linux.debug = "res://addons/microtex/bin/libmicrotex.linux.template_debug.x86_64.so"
linux.release = "res://addons/microtex/bin/libmicrotex.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://addons/microtex/bin/libmicrotex.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/microtex/bin/libmicrotex.windows.template_release.x86_64.dll"
windows.debug = "res://addons/microtex/bin/libmicrotex.windows.template_debug.x86_64.dll"
windows.release = "res://addons/microtex/bin/libmicrotex.windows.template_release.x86_64.dll"
macos.debug = "res://addons/microtex/bin/libmicrotex.macos.template_debug.framework"
macos.release = "res://addons/microtex/bin/libmicrotex.macos.template_release.framework"
linux.debug.arm64 = "res://addons/microtex/bin/libmicrotex.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/microtex/bin/libmicrotex.linux.template_release.arm64.so"
android.debug.arm64 = "res://addons/microtex/bin/libmicrotex.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/microtex/bin/libmicrotex.android.template_release.arm64.so"
